/ {
    behaviors {
        // ここでは個別の MT は定義しない
        // 全体設定だけを適用する
    };
};

// --- 全ての Mod-Tap に適用する設定 ---
&mt {
    // タップとホールドの判定時間（例：180ms）
    tapping-term-ms = <300>;

    // 素早く離したときにタップ扱いにする時間（例：100ms）
    quick-tap-ms = <100>;

    // ホールド判定を「離した瞬間」にする（好みで ON/OFF）
    // コメントアウトしても OK
    // hold-trigger-on-release;
};
